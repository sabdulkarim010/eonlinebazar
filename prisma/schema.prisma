/// Source: backend/src/models/PaymentMethod.js
/// The embedded `apiConfig` object is flattened onto this row. storePassword and
/// apiKey stay AES-256-GCM envelopes produced by utils/cryptoVault.js — they are
/// ciphertext strings, and Stage 3 must copy them verbatim without re-encrypting.
model PaymentMethod {
  id       String  @id @default(uuid())
  legacyId String? @unique

  name     String
  /// Stable machine key. Orders, IPN URLs and ledger exports reference this, so
  /// it never changes on rename.
  code     String            @unique
  logoUrl  String            @default("")
  type     PaymentMethodType @default(MANUAL)
  provider GatewayProvider?

  /// Shown under the option at checkout, manual methods only.
  instructions  String @default("")
  /// Merchant wallet / bank account the customer pays into (manual methods).
  accountNumber String @default("")

  processingFee Decimal @default(0) @db.Decimal(12, 2)
  feeType       FeeType @default(PERCENTAGE)
  sortOrder     Int     @default(0)

  apiStoreId       String  @default("")
  /// Encrypted at rest — see utils/cryptoVault.js.
  apiStorePassword String  @default("")
  apiKey           String  @default("")
  apiIsSandbox     Boolean @default(true)
  apiWebhookUrl    String  @default("")

  isActive       Boolean @default(true)
  description    String  @default("")
  createdByAdmin String  @default("")
  updatedByAdmin String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderPayments OrderPayment[]

  @@index([isActive, sortOrder, name])
  @@map("payment_methods")
}

/// Source: backend/src/models/banner.js — the Banner export.

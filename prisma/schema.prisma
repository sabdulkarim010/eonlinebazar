/// Source: backend/src/models/user.js
model User {
  id       String  @id @default(uuid())
  legacyId String? @unique

  firstName   String
  lastName    String
  gender      UserGender?
  dateOfBirth DateTime?
  mobile      String?
  email       String      @unique
  password    String?
  googleId    String?
  avatarUrl   String?
  lastLogin   DateTime?
  isVerified  Boolean     @default(false)

  accountStatus           UserAccountStatus @default(ACTIVE)
  verificationToken       String?
  verificationTokenExpiry DateTime?

  avatar         String @default("")
  avatarPublicId String @default("")

  // Legacy single-address columns, superseded by the Address table but still
  // written by profile updates and mobile checkout.
  phone       String @default("")
  address     String @default("")
  district    String @default("")
  upazila     String @default("")
  thana       String @default("")
  fullAddress String @default("")

  walletBalance Decimal @default(0) @db.Decimal(12, 2)
  loyaltyPoints Int     @default(0)

  referralCode     String? @unique
  referredById     String?
  referralEarnings Decimal @default(0) @db.Decimal(12, 2)

  loyaltyTier      LoyaltyTier @default(NONE)
  tierUpgradedAt   DateTime?
  lifetimeSpend    Decimal     @default(0) @db.Decimal(12, 2)
  tierCashbackRate Decimal     @default(0) @db.Decimal(5, 2)

  resetPasswordOtp     String?
  resetPasswordExpires DateTime?

  profileUpdateOtp        String?
  profileUpdateOtpExpires DateTime?
  profileUpdateType       ProfileUpdateType?
  pendingEmail            String?
  pendingMobile           String?

  isSandbox      Boolean   @default(false)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletionReason String    @default("")

  createdAt DateTime @default(now())

  // Self-relation: user.js referredBy -> User. SetNull so removing a referrer
  // never deletes the people they referred.
  referredBy User?  @relation("UserReferral", fields: [referredById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  referrals  User[] @relation("UserReferral")

  // Owned data — Cascade is correct, these rows have no meaning without the user.
  addresses     Address[]
  wishlist      WishlistItem[]
  walletHistory WalletTransaction[]
  sessions      UserSession[]
  notes         Note[]
  carts         Cart[]

  // Cross-aggregate — see the individual models for the chosen onDelete.
  orders            Order[]
  reviews           Review[]
  couponRedemptions CouponRedemption[]

  @@index([mobile])
  @@index([googleId])
  @@index([loyaltyTier])
  @@index([isDeleted])
  @@map("users")
}

/// Extracted from the embedded user.js `addresses[]` array (addressSchema).
model Address {
  id       String  @id @default(uuid())
  legacyId String? @unique

  userId String

  label          String   @default("Home")
  district       String   @default("")
  upazilaOrThana String   @default("")
  fullAddress    String
  phone          String   @default("")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

/// Extracted from the embedded user.js `walletHistory[]` array (walletHistorySchema).
/// `type` stays a free String: Mongo stores an open set here — the field comment
/// lists CREDIT | DEBIT | conversion | cashback | refund with no enum guard, and
/// live rows mix casings. Normalise in Stage 3 before promoting it to an enum.
model WalletTransaction {
  id       String  @id @default(uuid())
  legacyId String? @unique

  userId String

  type           String   @default("credit")
  amount         Decimal  @default(0) @db.Decimal(12, 2)
  note           String   @default("")
  referenceOrder String   @default("")
  date           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, date])
  @@map("wallet_transactions")
}

/// Extracted from the embedded user.js `wishlist[]` array (wishlist.js
/// wishlistItemSchema). `legacyProductId` keeps the raw Mongo string because
/// wishlists routinely outlive the products they point at.
model WishlistItem {
  id       String  @id @default(uuid())
  legacyId String? @unique

  userId          String
  legacyProductId String
  productId       String?

  name    String   @default("")
  price   Decimal  @default(0) @db.Decimal(12, 2)
  image   String   @default("")
  icon    String   @default("📦")
  addedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

/// Source: backend/src/models/userSession.js
model UserSession {
  id       String  @id @default(uuid())
  legacyId String? @unique

  sessionId String @unique
  userId    String

  userAgent    String   @default("")
  device       String   @default("Unknown Device")
  browser      String   @default("Unknown Browser")
  ipAddress    String   @default("")
  location     String   @default("Unknown Location")
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("user_sessions")
}


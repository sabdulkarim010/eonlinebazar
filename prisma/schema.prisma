/// Source: backend/src/models/product.js
model Product {
  id       String  @id @default(uuid())
  legacyId String? @unique

  productId String  @unique
  name      String?
  /// Sparse unique in Mongo — a nullable unique column is the exact equivalent.
  slug      String? @unique

  price       Decimal @db.Decimal(12, 2)
  buyingPrice Decimal @default(0) @db.Decimal(12, 2)

  /// Mongo stores the category NAME as a plain string, not an ObjectId, to keep
  /// pre-existing products readable. Both are kept: the snapshot name and the
  /// resolved FK. SetNull is deliberate — deleting a Category must never delete
  /// or orphan the products that were filed under it.
  categoryName String  @default("General")
  categoryId   String?

  brandId   String?
  brandName String  @default("")

  hasVariants       Boolean @default(false)
  stockQuantity     Int     @default(0)
  lowStockThreshold Int     @default(10)

  supplierId   String?
  warehouseId  String?
  reorderPoint Int     @default(5)

  /// Total available stock — equals stockQuantity for simple products, or the
  /// sum of variant stocks.
  stock Int @default(0)

  description         String   @default("")
  detailedDescription String   @default("")
  highlights          String[] @default([])
  tags                String[] @default([])
  /// Product weight in grams (courier integrations).
  weight              Int?

  status      ActiveStatus @default(ACTIVE)
  createdById String?

  icon   String   @default("📦")
  image  String   @default("")
  images String[] @default([])

  rating       Decimal @default(0) @db.Decimal(3, 2)
  numOfReviews Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  brand     Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supplier  Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy Admin?     @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  variants        ProductVariant[]
  costHistory     ProductCostHistory[]
  embeddedReviews ProductEmbeddedReview[]

  reviews            Review[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  orderReturnItems   OrderReturnItem[]
  purchaseOrderItems PurchaseOrderItem[]
  supplierLinks      SupplierProduct[]
  stockAlertItems    StockAlertItem[]

  @@index([categoryId])
  @@index([categoryName])
  @@index([price])
  @@index([rating])
  @@index([numOfReviews])
  @@index([brandId])
  @@index([stockQuantity])
  @@index([price, rating])
  @@index([brandId, price])
  @@map("products")
}

/// Extracted from the embedded product.js `variants[]` array (variantSchema).
/// Each row is one sellable SKU. `sku` is intentionally NOT unique: Mongo places
/// no unique guard on it and blank/duplicate SKUs exist in live data.
model ProductVariant {
  id       String  @id @default(uuid())
  legacyId String? @unique

  productId String

  /// Human-readable combination label, e.g. "Size: S | Color: Pink".
  name        String  @default("")
  sku         String  @default("")
  price       Decimal @default(0) @db.Decimal(12, 2)
  buyingPrice Decimal @default(0) @db.Decimal(12, 2)
  stock       Int     @default(0)
  image       String  @default("")

  /// Legacy flat fields, still read when hydrating older documents.
  attribute String @default("")
  value     String @default("")

  product    Product                   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attributes ProductVariantAttribute[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

/// Extracted from the `attributes` Map<String, String> on product.js
/// variantSchema. A Map has no relational equivalent, so each entry becomes a
/// row; this also makes "find every variant where Color = Pink" indexable.
model ProductVariantAttribute {
  id String @id @default(uuid())

  variantId String
  name      String
  value     String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([variantId, name])
  @@index([name, value])
  @@map("product_variant_attributes")
}

/// Extracted from the embedded product.js `costHistory[]` array — an append-only
/// buying-price trail written by purchase-order receiving.
model ProductCostHistory {
  id String @id @default(uuid())

  productId  String
  supplierId String?

  cost Decimal  @default(0) @db.Decimal(12, 2)
  date DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, date])
  @@index([supplierId])
  @@map("product_cost_history")
}

/// Extracted from the embedded product.js `reviews[]` array. This is the LEGACY
/// in-document review list and is distinct from the standalone Review model —
/// both exist in the live schema, so both are represented here.
model ProductEmbeddedReview {
  id       String  @id @default(uuid())
  legacyId String? @unique

  productId String
  userId    String?

  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@map("product_embedded_reviews")
}

/// Source: backend/src/models/category.js — hierarchical, self-referencing.
model Category {
  id       String  @id @default(uuid())
  legacyId String? @unique

  name        String @unique
  slug        String @unique
  description String @default("")

  imageUrl       String?
  iconUrl        String?
  bannerImageUrl String?
  color          String  @default("#f97316")

  /// SetNull, not Cascade: deleting a parent category promotes its children to
  /// root rather than silently destroying an entire subtree.
  parentCategoryId String?

  isActive       Boolean @default(true)
  isFeatured     Boolean @default(false)
  showInNavbar   Boolean @default(true)
  showInHomepage Boolean @default(false)
  position       Int     @default(0)

  /// A cashback percentage, not an amount.
  customCashback Decimal? @db.Decimal(5, 2)

  metaTitle       String @default("")
  metaDescription String @default("")
  productCount    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  parentCategory Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children       Category[] @relation("CategoryHierarchy")
  products       Product[]

  @@index([parentCategoryId, position, name])
  @@index([isActive, parentCategoryId, position])
  @@index([isActive, showInNavbar, parentCategoryId, position])
  @@index([isActive, showInHomepage, parentCategoryId, position])
  @@map("categories")
}

/// Source: backend/src/models/brand.js
model Brand {
  id       String  @id @default(uuid())
  legacyId String? @unique

  name        String       @unique
  slug        String       @default("")
  description String       @default("")
  status      ActiveStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@map("brands")
}

/// Source: backend/src/models/attribute.js
/// `values` stays a String[]: it is an unordered bag of terms ("S", "M", "L")
/// with no per-term metadata, so a child table would add joins for nothing.
model Attribute {
  id       String  @id @default(uuid())
  legacyId String? @unique

  name   String       @unique
  slug   String       @default("")
  values String[]     @default([])
  status ActiveStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("attributes")
}

/// Source: backend/src/models/supplier.js
model Supplier {
  id       String  @id @default(uuid())
  legacyId String? @unique

  name          String
  contactPerson String       @default("")
  phone         String       @default("")
  email         String       @default("")
  address       String       @default("")
  notes         String       @default("")
  status        ActiveStatus @default(ACTIVE)
  createdById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy Admin? @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  products         Product[]
  suppliedProducts SupplierProduct[]
  costHistory      ProductCostHistory[]
  /// Restrict — see PurchaseOrder.supplierId. Historical POs outrank the vendor row.
  purchaseOrders   PurchaseOrder[]

  @@index([status, createdAt])
  @@index([name])
  @@map("suppliers")
}

/// Extracted from the embedded supplier.js `suppliedProducts[]` ObjectId array.
/// A display/filter roster only — the authoritative link is Product.supplierId —
/// so Cascade on both sides is safe: removing either end just removes the hint.
model SupplierProduct {
  id String @id @default(uuid())

  supplierId String
  productId  String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
  @@map("supplier_products")
}

/// Source: backend/src/models/warehouse.js
model Warehouse {
  id       String  @id @default(uuid())
  legacyId String? @unique

  name        String
  /// Short label shown in dropdowns, e.g. "Dhaka — Mirpur".
  location    String       @default("")
  address     String       @default("")
  managerName String       @default("")
  phone       String       @default("")
  /// Exactly one warehouse holds this flag — enforced by the controller.
  isDefault   Boolean      @default(false)
  status      ActiveStatus @default(ACTIVE)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy Admin? @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([status, createdAt])
  @@index([isDefault])
  @@map("warehouses")
}

/// Source: backend/src/models/purchaseOrder.js
model PurchaseOrder {
  id       String  @id @default(uuid())
  legacyId String? @unique

  poNumber String @unique

  /// Restrict, NOT Cascade or SetNull. A purchase order is an accounting
  /// document; deleting a vendor must fail while its POs exist rather than
  /// erase the goods-receiving history. This matches supplierController.js,
  /// which already refuses to delete a supplier with open POs.
  supplierId  String
  warehouseId String?

  status    PurchaseOrderStatus @default(DRAFT)
  /// Kept in sync on every write by a pre-save hook (sum of qty × unitCost).
  totalCost Decimal             @default(0) @db.Decimal(12, 2)

  expectedDate  DateTime?
  receivedDate  DateTime?
  notes         String    @default("")
  createdById   String?
  createdByName String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier  Supplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy Admin?     @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  items PurchaseOrderItem[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("purchase_orders")
}

/// Extracted from the embedded purchaseOrder.js `items[]` array.
/// `productId` is required in Mongo but nullable here with SetNull: the
/// `productName` snapshot exists precisely so a deleted product still prints on
/// the PO, and Cascade would delete accounting lines.
model PurchaseOrderItem {
  id       String  @id @default(uuid())
  legacyId String? @unique

  purchaseOrderId String
  productId       String?
  legacyProductId String?

  /// Name snapshot so a deleted product still prints on the PO.
  productName String  @default("")
  qty         Int     @default(1)
  unitCost    Decimal @default(0) @db.Decimal(12, 2)
  receivedQty Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}


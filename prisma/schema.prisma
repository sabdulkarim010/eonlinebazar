/// Source: backend/src/models/expense.js
/// `category` is a dynamic slug string validated against the ExpenseCategory
/// catalog at write time, NOT a Mongoose enum — so it stays a String plus a
/// resolved FK. Restrict matches expenseCategoryController.js, which refuses to
/// delete a category that still has expenses linked to it.
model Expense {
  id       String  @id @default(uuid())
  legacyId String? @unique

  category           String
  expenseCategoryId  String?
  /// Free-text name used when the "Other" category has allowCustomInput enabled.
  customCategoryName String  @default("")

  amount        Decimal  @db.Decimal(12, 2)
  description   String   @default("")
  date          DateTime @default(now())
  /// Invoice / receipt reference number for reconciliation.
  reference     String   @default("")
  recordedBy    String   @default("")
  attachmentUrl String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([date])
  @@index([category, date])
  @@index([expenseCategoryId])
  @@map("expenses")
}

/// Source: backend/src/models/expenseCategory.js

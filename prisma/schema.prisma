/// Source: backend/src/models/order.js
/// `orderId` is indexed but NOT unique in Mongo, so it is not unique here either
/// — adding the constraint now would reject legacy duplicates during Stage 3.
model Order {
  id       String  @id @default(uuid())
  legacyId String? @unique

  orderId String?
  /// SetNull, never Cascade: guest checkout already produces orders with no
  /// user, and deleting a customer must not erase revenue history.
  userId  String?

  customerName    String?
  customerPhone   String?
  customerAddress String?

  subTotal       Decimal @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal @default(0) @db.Decimal(12, 2)

  shippingLocationType ShippingLocationType @default(INSIDE_CITY)
  shippingDistrict     String               @default("")

  totalAmount      Decimal? @db.Decimal(12, 2)
  /// Order-level sum of item buyingPrice × quantity, stored for fast P&L.
  totalBuyingPrice Decimal  @default(0) @db.Decimal(12, 2)

  /// Legacy lowercase twin of `subTotal`. Both fields exist in the live schema
  /// and both are written, so both are preserved. Reconcile in Stage 3.
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  vatAmount             Decimal @default(0) @db.Decimal(12, 2)
  vatPercentage         Decimal @default(0) @db.Decimal(5, 2)
  vatEnabled            Boolean @default(false)
  taxRegistrationNumber String  @default("")

  walletApplied        Decimal              @default(0) @db.Decimal(12, 2)
  couponCode           String               @default("")
  deliveryLocationType DeliveryLocationType @default(INSIDE)
  shippingFee          Decimal              @default(0) @db.Decimal(12, 2)

  /// Human-readable label mirroring OrderPayment.name (invoices, tables, SMS).
  paymentMethod String  @default("COD")
  /// Gateway processing fee at order level, already included in grandTotal.
  processingFee Decimal @default(0) @db.Decimal(12, 2)

  status      OrderStatus @default(PENDING)
  isDelivered Boolean     @default(false)
  deliveredAt DateTime?

  cancelReason String       @default("")
  cancelledBy  CancelledBy?

  returnReason         String       @default("")
  returnRequestedAt    DateTime?
  refundMethod         RefundMethod @default(WALLET)
  refundBkashNumber    String       @default("")
  refundNagadNumber    String       @default("")
  returnRejectedReason String       @default("")
  returnRejectedAt     DateTime?
  returnApprovedAt     DateTime?
  adminReturnNote      String       @default("")
  /// Legacy field mirroring the cancel/return reason.
  actionReason         String       @default("")

  refundedAt         DateTime?
  refundAmount       Decimal   @default(0) @db.Decimal(12, 2)
  statusBeforeRefund String    @default("")

  rewardsCredited       Boolean @default(false)
  rewardsPointsEarned   Int     @default(0)
  rewardsCashbackAmount Decimal @default(0) @db.Decimal(12, 2)

  courierProvider      String    @default("")
  courierName          String    @default("")
  courierTrackingId    String    @default("")
  courierConsignmentId String    @default("")
  courierStatus        String    @default("unbooked")
  courierBookedAt      DateTime?
  courierSyncedAt      DateTime?

  note              String      @default("")
  estimatedDelivery String      @default("")
  orderSource       OrderSource @default(ONLINE)
  createdByAdmin    String      @default("")

  /// Loose staff reference in Mongo (Admin _id as a string), left as a String
  /// here because POS/manual orders also store non-Admin values.
  assignedStaffId String?
  assignedAt      DateTime?

  isSandbox Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  items             OrderItem[]
  returnItems       OrderReturnItem[]
  payment           OrderPayment?
  paymentProof      OrderPaymentProof?
  notificationsSent OrderNotification?

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([isSandbox])
  @@map("orders")
}

/// Extracted from the embedded order.js `items[]` array (orderItemSchema).
///
/// HIGH RISK: orderItemSchema is declared `strict: false`, so live order lines
/// can carry any extra field the cart happened to send (icon, slug, …). Those
/// undeclared keys land in `extraFields` during Stage 3 rather than being
/// dropped; audit that column before Stage 5 and promote anything real.
model OrderItem {
  id       String  @id @default(uuid())
  legacyId String? @unique

  orderId         String
  /// SetNull with a snapshot: order lines must survive product deletion.
  productId       String?
  legacyProductId String?
  /// order.js also carries a separate loose `id` field on each line.
  lineKey         String?

  name        String?
  price       Decimal @default(0) @db.Decimal(12, 2)
  /// Cost-price snapshot taken at order time so later price changes cannot
  /// distort historical profit reporting.
  buyingPrice Decimal @default(0) @db.Decimal(12, 2)
  quantity    Int     @default(1)
  image       String?

  variantId        String @default("")
  variantLabel     String @default("")
  variantAttribute String @default("")
  variantValue     String @default("")
  variantSku       String @default("")

  /// Catch-all for `strict: false` keys — see the model comment above.
  extraFields Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Extracted from the embedded order.js `returnItems[]` array (returnItemSchema).
model OrderReturnItem {
  id       String  @id @default(uuid())
  legacyId String? @unique

  orderId         String
  productId       String?
  legacyProductId String?

  productName String           @default("")
  quantity    Int              @default(1)
  price       Decimal          @default(0) @db.Decimal(12, 2)
  reason      String           @default("")
  photos      String[]         @default([])
  status      ReturnItemStatus @default(PENDING)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_return_items")
}

/// Extracted from the embedded order.js `payment` object (orderPaymentSchema).
/// One row per order, hence the unique orderId.
model OrderPayment {
  id String @id @default(uuid())

  orderId  String  @unique
  /// SetNull: the snapshot columns below exist so that renaming, re-pricing or
  /// deleting a payment method leaves historical ledger rows untouched.
  methodId String?

  code     String            @default("")
  name     String            @default("")
  type     PaymentMethodType @default(MANUAL)
  provider String            @default("")

  /// Merchant wallet/bank number for manual methods (reconciliation).
  accountNumber  String  @default("")
  /// Automated gateway storeId — which merchant account received the money.
  gatewayStoreId String  @default("")
  isSandbox      Boolean @default(false)

  processingFee Decimal @default(0) @db.Decimal(12, 2)
  feeType       FeeType @default(PERCENTAGE)
  /// A rate, not an amount — flat fee or percentage depending on feeType.
  feeRate       Decimal @default(0) @db.Decimal(12, 2)
  feeBaseAmount Decimal @default(0) @db.Decimal(12, 2)

  status            OrderPaymentStatus @default(UNPAID)
  transactionId     String             @default("")
  gatewayReference  String             @default("")
  paidAt            DateTime?
  settledFromWallet Boolean            @default(false)

  order      Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  method     PaymentMethod?         @relation(fields: [methodId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ipnHistory OrderPaymentIpnEvent[]

  @@index([transactionId])
  @@index([methodId])
  @@map("order_payments")
}

/// Extracted from the embedded `payment.ipnHistory[]` array (ipnEventSchema).
/// `raw` is `mongoose.Schema.Types.Mixed` — an untyped gateway payload — so it
/// stays Json. It is an audit trail, never queried by shape.
model OrderPaymentIpnEvent {
  id String @id @default(uuid())

  orderPaymentId String

  receivedAt    DateTime @default(now())
  provider      String   @default("")
  status        String   @default("")
  verified      Boolean  @default(false)
  transactionId String   @default("")
  amount        Decimal  @default(0) @db.Decimal(12, 2)
  message       String   @default("")
  raw           Json?

  orderPayment OrderPayment @relation(fields: [orderPaymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderPaymentId, receivedAt])
  @@map("order_payment_ipn_events")
}

/// Extracted from the embedded order.js `paymentProof` object (paymentProofSchema).
model OrderPaymentProof {
  id String @id @default(uuid())

  orderId      String  @unique
  reviewedById String?

  trxId         String?
  screenshotUrl String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  status        PaymentProofStatus @default(NONE)
  adminNote     String?

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewedBy Admin? @relation(fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, submittedAt])
  @@map("order_payment_proofs")
}

/// Extracted from the embedded order.js `notificationsSent` object
/// (orderNotificationsSchema) — idempotency flags that stop duplicate sends.
model OrderNotification {
  id String @id @default(uuid())

  orderId String @unique

  returnReceived  Boolean @default(false)
  returnApproved  Boolean @default(false)
  returnRejected  Boolean @default(false)
  refundProcessed Boolean @default(false)
  reviewReminder  Boolean @default(false)
  processing      Boolean @default(false)
  shipped         Boolean @default(false)
  outForDelivery  Boolean @default(false) @map("out_for_delivery")
  delivered       Boolean @default(false)
  cancelled       Boolean @default(false)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("order_notifications")
}

/// Source: backend/src/models/cart.js
/// Not unique on userId: Mongo places no such constraint and duplicate carts
/// exist in live data. Enforce one-cart-per-user in Stage 3 after de-duping.
model Cart {
  id       String  @id @default(uuid())
  legacyId String? @unique

  userId String

  /// Abandoned-cart tracking (abandonedCartJob.js). lastActivityAt bumps on
  /// every mutation; abandonedNotifiedAt re-arms so a shopper is not spammed.
  lastActivityAt      DateTime  @default(now())
  abandonedNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items CartItem[]

  @@index([userId, updatedAt])
  @@map("carts")
}

/// Extracted from the embedded cart.js `items[]` array. Cascade from Product is
/// correct here and only here: a deleted product must vanish from open carts,
/// unlike order lines, which are financial history.
model CartItem {
  id String @id @default(uuid())

  cartId    String
  productId String

  name         String
  price        Decimal @db.Decimal(12, 2)
  image        String  @default("")
  emojiIcon    String?
  variantImage String?
  icon         String  @default("📦")
  quantity     Int     @default(1)
  selected     Boolean @default(true)

  variantId        String @default("")
  variantLabel     String @default("")
  variantAttribute String @default("")
  variantValue     String @default("")
  variantSku       String @default("")
  selectedColor    String @default("")
  selectedSize     String @default("")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

/// Source: backend/src/models/coupon.js
model Coupon {
  id       String  @id @default(uuid())
  legacyId String? @unique

  code              String             @unique
  discountType      CouponDiscountType
  /// Either a percentage or a flat amount, selected by discountType. Kept at
  /// money scale because the flat case is money.
  discountValue     Decimal            @db.Decimal(12, 2)
  minOrderAmount    Decimal            @default(0) @db.Decimal(12, 2)
  /// Ceiling for percentage discounts; null means no cap.
  maxDiscountAmount Decimal?           @db.Decimal(12, 2)

  expiryDate   DateTime
  status       CouponStatus @default(ACTIVE)
  usageLimit   Int
  usedCount    Int          @default(0)
  perUserLimit Int          @default(1)
  /// Deprecated in Mongo but still written — synced from `status` on save.
  isActive     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([status, expiryDate])
  @@map("coupons")
}

/// Extracted from the embedded coupon.js `usedBy[]` ObjectId array. NOT unique
/// on (couponId, userId): the same user may appear multiple times, once per
/// redemption, which is how perUserLimit is enforced.
model CouponRedemption {
  id String @id @default(uuid())

  couponId String
  userId   String

  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([couponId, userId])
  @@index([userId])
  @@map("coupon_redemptions")
}

/// Source: backend/src/models/review.js
/// userId is required in Mongo but nullable here: SetNull anonymises a review
/// when an account is erased instead of destroying product feedback.
/// productId and orderId are plain Strings in Mongo, so both raw values are kept
/// alongside the resolved product FK.
model Review {
  id       String  @id @default(uuid())
  legacyId String? @unique

  userId          String?
  productId       String?
  legacyProductId String
  legacyOrderId   String

  rating      Int
  comment     String
  photo       String    @default("")
  isSandbox   Boolean   @default(false)
  isHidden    Boolean   @default(false)
  adminNote   String    @default("")
  moderatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([legacyProductId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}


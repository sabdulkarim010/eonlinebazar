/// Source: backend/src/models/admin.js
/// `permissions` is a String[] rather than an enum: the grantable set lives in
/// config/permissions.js and is sanitised on write, and unknown keys are dropped
/// rather than rejected so a stale browser tab cannot grant a retired
/// permission. A Postgres enum would turn that soft behaviour into a hard error.
model Admin {
  id       String  @id @default(uuid())
  legacyId String? @unique

  username String @unique
  password String
  name     String @default("")

  role        AdminRole          @default(SUPERADMIN)
  permissions String[]           @default([])
  status      AdminAccountStatus @default(ACTIVE)
  createdBy   String             @default("")

  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  email             String    @default("")
  phone             String    @default("")

  twoFactorMethod   TwoFactorMethod @default(EMAIL)
  twoFactorEnabled  Boolean         @default(true)
  otp               String?
  otpExpiry         BigInt?
  totpSecret        String?
  totpPendingSecret String?
  totpVerified      Boolean         @default(false)
  smsSetupOtp       String?
  smsSetupOtpExpiry BigInt?

  image          String @default("")
  displayName    String @default("Super Admin")
  storeName      String @default("EonlineBazar")
  currency       String @default("BDT")
  currencySymbol String @default("৳")
  timezone       String @default("Asia/Dhaka")
  logoUrl        String @default("")
  faviconUrl     String @default("")

  // HRM employment record — payroll reads baseSalary straight off this row.
  baseSalary  Decimal   @default(0) @db.Decimal(12, 2)
  department  String    @default("")
  joiningDate DateTime?
  employeeId  String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Back-relation for the 1:1 HRM provisioning link. The stored FK lives on
  /// Employee.linkedAdminId; admin.js `employeeRef` is the same edge written
  /// twice and is derived here instead (see DATABASE_MIGRATION_AUDIT.md).
  employee Employee?

  sessions          AdminSession[]
  createdProducts   Product[]
  createdSuppliers  Supplier[]
  createdWarehouses Warehouse[]
  purchaseOrders    PurchaseOrder[]
  reviewedProofs    OrderPaymentProof[]
  campaigns         EmailCampaign[]
  notifications     AdminNotification[]
  attendance        Attendance[]
  payrolls          Payroll[]
  leaves            Leave[]

  @@index([role])
  @@index([status])
  @@map("admins")
}

/// Source: backend/src/models/adminSession.js
/// Mongo keys these by `adminUsername`, so that column is preserved verbatim.
/// `adminId` is the resolved FK added for Stage 4; Cascade is right because a
/// deleted admin must not leave live sessions behind.
model AdminSession {
  id       String  @id @default(uuid())
  legacyId String? @unique

  sessionId     String  @unique
  adminUsername String
  adminId       String?

  ipAddress  String             @default("Unknown")
  location   String             @default("Unknown Location")
  os         String             @default("Unknown OS")
  browser    String             @default("Unknown Browser")
  deviceType String             @default("Desktop")
  device     String             @default("Unknown Device")
  userAgent  String             @default("")
  status     AdminSessionStatus @default(ACTIVE)
  lastActive DateTime           @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([adminUsername])
  @@index([status])
  @@index([adminId])
  @@map("admin_sessions")
}

/// Source: backend/src/models/employee.js — non-login operational staff.
model Employee {
  id       String  @id @default(uuid())
  legacyId String? @unique

  employeeId String @unique
  fullName   String

  dateOfBirth   DateTime?
  gender        EmployeeGender?
  bloodGroup    BloodGroup?
  religion      String          @default("")
  maritalStatus MaritalStatus?
  nationalId    String          @default("")
  photo         String          @default("")
  photoPublicId String          @default("")

  phone            String
  alternatePhone   String @default("")
  email            String @default("")
  presentAddress   String @default("")
  permanentAddress String @default("")
  /// Legacy single-address field, kept in sync with presentAddress by a pre-save hook.
  address          String @default("")

  emergencyContactName     String @default("")
  emergencyContactPhone    String @default("")
  emergencyContactRelation String @default("")

  /// Canonical job title, stored by name in Mongo. `designationId` is the
  /// resolved FK; Restrict mirrors the controller rule that a designation
  /// cannot be deleted while employees still carry its name.
  designation   String       @default("")
  designationId String?
  /// Legacy alias kept in sync with `designation` by a pre-save hook.
  role          String       @default("")
  department    String       @default("Operations")
  employeeType  EmployeeType @default(PERMANENT)
  /// Shift name string in Mongo; `shiftId` is the resolved FK.
  shift         String       @default("")
  shiftId       String?
  joiningDate   DateTime?

  baseSalary        Decimal    @default(0) @db.Decimal(12, 2)
  salaryType        SalaryType @default(MONTHLY)
  bankName          String     @default("")
  bankAccountNumber String     @default("")
  bkashNumber       String     @default("")

  /// 1:1 system-access link. SetNull so revoking or deleting the panel account
  /// never deletes the HR record.
  linkedAdminId String? @unique

  status    EmployeeStatus @default(ACTIVE)
  notes     String         @default("")
  createdBy String         @default("")
  /// Mirrors Mongoose __v for read-cutover HTTP parity (synced from Mongo on backfill).
  mongoVersion Int @default(0) @map("mongo_version")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkedAdmin    Admin?       @relation(fields: [linkedAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  designationRef Designation? @relation(fields: [designationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shiftRef       Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  documents  EmployeeDocument[]
  references EmployeeReference[]
  attendance Attendance[]
  payrolls   Payroll[]
  leaves     Leave[]

  @@index([status])
  @@index([department])
  @@index([designation])
  @@index([employeeType])
  @@map("employees")
}


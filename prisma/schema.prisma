/// Source: backend/src/models/securityLog.js
/// `actor` stays a String (username or "system") so an audit row outlives the
/// account that produced it — an audit trail with FK-nulled actors is useless.
model SecurityLog {
  id       String  @id @default(uuid())
  legacyId String? @unique

  action       String
  actor        String                @default("system")
  actorType    SecurityActorType     @default(SYSTEM)
  ipAddress    String                @default("Unknown")
  details      String                @default("")
  resourceType SecurityResourceType?
  resourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([actor, actorType, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("security_logs")
}

/// Source: backend/src/models/loginAttempt.js
/// Mongo purges these with a 30-day TTL index on createdAt. Postgres has no TTL,
/// so Stage 2 must add a scheduled delete job — see DATABASE_MIGRATION_AUDIT.md.
model LoginAttempt {
  id       String  @id @default(uuid())
  legacyId String? @unique

  username   String             @default("unknown")
  ipAddress  String             @default("Unknown")
  location   String             @default("Unknown Location")
  os         String             @default("Unknown OS")
  browser    String             @default("Unknown Browser")
  deviceType String             @default("Desktop")
  userAgent  String             @default("")
  status     LoginAttemptStatus @default(FAILED)
  details    String             @default("")

  createdAt DateTime @default(now())

  @@index([ipAddress])
  @@index([status])
  @@index([ipAddress, status, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Source: backend/src/models/blacklistedIp.js
/// Mongo removes rows the moment `expiresAt` passes (TTL index, expireAfterSeconds: 0);
/// a null expiresAt means a permanent ban. Postgres needs a scheduled sweep instead.
model BlacklistedIp {
  id       String  @id @default(uuid())
  legacyId String? @unique

  ip        String          @unique
  reason    String          @default("Suspicious activity")
  source    BlacklistSource @default(AUTO)
  blockedBy String          @default("system")
  blockedAt DateTime        @default(now())
  /// null => permanent ban.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("blacklisted_ips")
}

/// Source: backend/src/models/stockAlert.js — one row per alert run.
/// The `alertsSent` sub-object is flattened into three booleans.
model StockAlert {
  id       String  @id @default(uuid())
  legacyId String? @unique

  checkedAt       DateTime
  lowStockCount   Int      @default(0)
  outOfStockCount Int      @default(0)

  alertSentEmail    Boolean @default(false)
  alertSentSms      Boolean @default(false)
  alertSentWhatsapp Boolean @default(false)

  createdAt DateTime @default(now())

  items StockAlertItem[]

  @@index([checkedAt])
  @@map("stock_alerts")
}

/// Collapses the two embedded stockAlert.js arrays — `lowStockProducts[]` and
/// `outOfStockProducts[]` — into one child table discriminated by `kind`. The
/// out-of-stock shape has no stock/threshold, so those columns are nullable.
model StockAlertItem {
  id String @id @default(uuid())

  stockAlertId    String
  kind            StockAlertItemKind
  productId       String?
  legacyProductId String             @default("")

  name      String @default("")
  stock     Int?
  threshold Int?

  stockAlert StockAlert @relation(fields: [stockAlertId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([stockAlertId, kind])
  @@index([productId])
  @@map("stock_alert_items")
}


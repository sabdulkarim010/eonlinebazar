/// Extracted from the embedded shift.js `assignedStaff[]` string array. HRM keys
/// staff by username, so the username is the payload rather than an FK.
model ShiftAssignment {
  id String @id @default(uuid())

  shiftId       String
  staffUsername String

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([shiftId, staffUsername])
  @@index([staffUsername])
  @@map("shift_assignments")
}

/// Source: backend/src/models/attendance.js — one row per staff member per day.
/// `staffId` + `staffType` is the polymorphic key Mongo uses. Postgres cannot
/// foreign-key that, so both resolved FKs are carried alongside it; exactly one
/// is populated, selected by staffType.
model Attendance {
  id       String  @id @default(uuid())
  legacyId String? @unique

  staffId       String
  staffType     StaffType @default(ADMIN)
  adminId       String?
  employeeId    String?
  staffUsername String    @default("")

  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  /// Derived from clockIn/clockOut by a pre-save hook — never written by hand.
  hoursWorked Decimal          @default(0) @db.Decimal(6, 2)
  status      AttendanceStatus @default(ABSENT)
  isLate      Boolean          @default(false)
  lateMinutes Int              @default(0)

  shift      AttendanceShiftType @default(MORNING)
  shiftStart String              @default("09:00")
  shiftEnd   String              @default("18:00")

  /// Flattened from the embedded `gpsLocation` object; set only on mobile clock-in.
  gpsLat Decimal? @db.Decimal(10, 7)
  gpsLng Decimal? @db.Decimal(10, 7)

  notes    String @default("")
  markedBy String @default("self")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin    Admin?    @relation(fields: [adminId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([staffId, date])
  @@index([date, status])
  @@index([adminId])
  @@index([employeeId])
  @@map("attendance")
}

/// Source: backend/src/models/payroll.js — one salary run per staff per month.
model Payroll {
  id       String  @id @default(uuid())
  legacyId String? @unique

  staffId       String
  staffType     StaffType @default(ADMIN)
  adminId       String?
  employeeId    String?
  staffUsername String    @default("")
  staffName     String    @default("")

  /// 1–12 calendar month, not zero-based.
  month Int
  year  Int

  baseSalary     Decimal @default(0) @db.Decimal(12, 2)
  bonus          Decimal @default(0) @db.Decimal(12, 2)
  /// Overtime in HOURS — not money, hence the different scale.
  overtime       Decimal @default(0) @db.Decimal(6, 2)
  overtimeRate   Decimal @default(0) @db.Decimal(12, 2)
  overtimeAmount Decimal @default(0) @db.Decimal(12, 2)
  deductions     Decimal @default(0) @db.Decimal(12, 2)
  /// Derived by a pre-save hook — never written by hand.
  totalSalary    Decimal @default(0) @db.Decimal(12, 2)

  workingDays Int @default(0)
  presentDays Int @default(0)
  absentDays  Int @default(0)
  lateDays    Int @default(0)

  status           PayrollStatus @default(DRAFT)
  paidAt           DateTime?
  paymentMethod    String        @default("")
  paySlipGenerated Boolean       @default(false)
  notes            String        @default("")
  createdBy        String        @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin    Admin?    @relation(fields: [adminId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([staffId, year, month])
  @@index([year, month, status])
  @@index([adminId])
  @@index([employeeId])
  @@map("payrolls")
}

/// Source: backend/src/models/leave.js
/// `approvedBy` stays a username String, matching Mongo — HRM identifies
/// approvers by username, and the stamp must survive the approver's deletion.
model Leave {
  id       String  @id @default(uuid())
  legacyId String? @unique

  staffId       String
  staffType     StaffType @default(ADMIN)
  adminId       String?
  employeeId    String?
  staffUsername String    @default("")
  staffName     String    @default("")

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  /// Derived by a pre-save hook — inclusive of both end points, minimum 1.
  totalDays Int       @default(1)
  reason    String    @default("")

  status          LeaveStatus @default(PENDING)
  approvedBy      String      @default("")
  approvedAt      DateTime?
  rejectionReason String      @default("")
  attachmentUrl   String      @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin    Admin?    @relation(fields: [adminId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([staffId, startDate])
  @@index([status, startDate])
  @@index([startDate, endDate])
  @@index([adminId])
  @@index([employeeId])
  @@map("leaves")
}


/// Source: backend/src/models/NavbarLink.js
/// The link to PageContent is by slug, not by FK — NavbarLink.pageHtml is synced
/// into a PageContent row on save. Left slug-coupled to match live behaviour.
model NavbarLink {
  id       String  @id @default(uuid())
  legacyId String? @unique

  title  String
  /// Relative (/deals) or absolute (https://…).
  url    String
  slug   String     @default("")
  target LinkTarget @default(SELF)

  isPublished   Boolean @default(true)
  /// When true this link owns a dynamic CMS page at /page/:slug.
  hasCustomPage Boolean @default(false)
  /// Quill / rich-text HTML for the linked CMS page.
  pageHtml      String  @default("")
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isPublished, sortOrder, title])
  @@map("navbar_links")
}

/// Source: backend/src/models/note.js — private per-user notebook entries.
model Note {
  id       String  @id @default(uuid())
  legacyId String? @unique

  userId String

  title   String
  content String   @default("")
  type    NoteType @default(NOTE)
  /// Optional in Mongo (`default: undefined`) — a note has no amount, an expense does.
  amount  Decimal? @db.Decimal(12, 2)

  category NoteCategory @default(OTHER)
  tags     String[]     @default([])
  pinned   Boolean      @default(false)
  color    String       @default("#FFFEF0")
  date     DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shoppingItems NoteShoppingItem[]

  @@index([userId])
  @@index([type])
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([userId, date])
  @@map("notes")
}

/// Extracted from the embedded note.js `shoppingItems[]` array (shoppingItemSchema).
model NoteShoppingItem {
  id String @id @default(uuid())

  noteId String

  name    String  @default("")
  price   Decimal @default(0) @db.Decimal(12, 2)
  checked Boolean @default(false)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([noteId])
  @@map("note_shopping_items")
}

/// Source: backend/src/models/adminNotification.js
/// `recipientId` is an Admin _id stored as a String; `adminId` is the resolved
/// FK. Cascade — a personal inbox has no meaning without its owner.
model AdminNotification {
  id       String  @id @default(uuid())
  legacyId String? @unique

  recipientId String
  adminId     String?

  type    AdminNotificationType
  title   String
  message String
  link    String                @default("")
  isRead  Boolean               @default(false)

  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([recipientId])
  @@index([createdAt])
  @@index([recipientId, isRead, createdAt])
  @@index([adminId])
  @@map("admin_notifications")
}

// ============================================================================
// SETTINGS — Settings.js (singleton, key = 'global')
//
// This is the CONSOLIDATED model. Setting.js was merged into Settings.js on
// 2026-09-12 and is now a re-export shim, so there is exactly one settings
// table here and the former `key: 'master'` document has no counterpart.
// ============================================================================

/// Source: backend/src/models/Settings.js
model Settings {
  id  String @id @default(uuid())
  /// Immutable in Mongo — the singleton discriminator.
  key String @unique @default("global")

  shopHomeCity          String   @default("Dhaka")
  deliveryInsideCity    Decimal  @default(60) @db.Decimal(12, 2)
  deliveryOutsideCity   Decimal  @default(120) @db.Decimal(12, 2)
  freeShippingMinAmount Decimal  @default(1000) @db.Decimal(12, 2)
  /// Canonical threshold that mirrors freeShippingMinAmount; null = unset.
  freeShippingThreshold Decimal? @db.Decimal(12, 2)

  cashbackPercentage         Decimal @default(1) @db.Decimal(5, 2)
  takaToPointsRatio          Int     @default(100)
  pointsToTakaConversionRate Int     @default(10)
  refundUndoWindowHours      Int     @default(72)

  announcementText     String  @default("")
  /// Stored as a String in Mongo despite looking numeric — kept as text so the
  /// legacy default '2000' migrates without a lossy cast.
  announcementDiscount String  @default("2000")
  isAnnouncementActive Boolean @default(true)

  enableSmsNotifications Boolean             @default(false)
  smsGatewayProvider     SmsGatewayProvider?
  smsApiKey              String              @default("")
  smsSenderId            String              @default("")

  /// HIGH RISK — left as a String on purpose. The Mongoose enum lists the same
  /// three providers twice, in two casings
  /// ('Steadfast','Pathao','RedX','steadfast','pathao','redx',''), so live rows
  /// are inconsistent. Normalise the casing in Stage 3, then promote to an enum.
  defaultCourierProvider String @default("")
  courierApiKey          String @default("")
  courierSecretKey       String @default("")

  publicSupportWhatsApp     String                 @default("")
  privateAdminAlertWhatsApp String                 @default("")
  enableWhatsAppOrderAlerts Boolean                @default(false)
  whatsAppAlertProvider     WhatsAppAlertProvider?
  whatsAppAlertApiKey       String                 @default("")
  whatsAppAlertInstanceId   String                 @default("")
  whatsAppAlertWebhookUrl   String                 @default("")

  /// Flattened from the embedded `activePaymentGateways` object — five booleans
  /// on fixed keys. Distinct from the richer `paymentGateways` child table below,
  /// which the live schema also carries.
  activeGatewayBKash      Boolean @default(true)
  activeGatewayNagad      Boolean @default(true)
  activeGatewayVisa       Boolean @default(true)
  activeGatewayMasterCard Boolean @default(true)
  activeGatewayCod        Boolean @default(true)

  rateLimitEnabled        Boolean @default(true)
  rateLimitWindowMs       Int     @default(900000)
  rateLimitMaxRequests    Int     @default(1000)
  bypassAdminAndLocalhost Boolean @default(true)
  sandboxMode             Boolean @default(false)
  serviceWorkerEnabled    Boolean @default(true)

  flashSaleEnabled         Boolean   @default(false)
  flashSaleTitle           String    @default("Flash Sale")
  flashSaleEndDate         DateTime?
  flashSaleDiscountPercent Decimal   @default(0) @db.Decimal(5, 2)
  /// Loose product id strings, kept as an array to match Mongo. Resolve to real
  /// FKs in Stage 3 if flash sales need referential integrity.
  flashSaleProductIds      String[]  @default([])

  vipMinTotalSpent       Decimal @default(10000) @db.Decimal(12, 2)
  vipMinOrderCount       Int     @default(5)
  frequentBuyerMinOrders Int     @default(3)
  referralRewardAmount   Decimal @default(100) @db.Decimal(12, 2)

  enableTieredLoyalty Boolean @default(false)
  silverThreshold     Decimal @default(5000) @db.Decimal(12, 2)
  goldThreshold       Decimal @default(15000) @db.Decimal(12, 2)
  platinumThreshold   Decimal @default(50000) @db.Decimal(12, 2)
  silverCashback      Decimal @default(1.5) @db.Decimal(5, 2)
  goldCashback        Decimal @default(2.5) @db.Decimal(5, 2)
  platinumCashback    Decimal @default(4.0) @db.Decimal(5, 2)

  defaultProductsPerPage Int @default(24)

  /// Legacy percentage kept in sync with vatPercentage by masterSettingsController.
  vatRate               Decimal @default(0) @db.Decimal(5, 2)
  vatEnabled            Boolean @default(false)
  vatPercentage         Decimal @default(0) @db.Decimal(5, 2)
  vatInclusive          Boolean @default(true)
  taxRegistrationNumber String  @default("")

  lastBackupAt DateTime?
  orderPrefix  String    @default("ORD")

  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("We are currently performing scheduled maintenance. Please check back soon.")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentGateways SettingsPaymentGateway[]

  @@map("settings")
}

/// Extracted from the embedded Settings.js `paymentGateways` object, which is a
/// fixed-key map of five { enabled, name, logoUrl } records (bKash, Nagad, Visa,
/// MasterCard, COD). One row per key so the display name and logo are editable
/// without a schema change.
model SettingsPaymentGateway {
  id String @id @default(uuid())

  settingsId String
  /// 'bKash' | 'Nagad' | 'Visa' | 'MasterCard' | 'COD' — the original object key.
  gatewayKey String

  enabled Boolean @default(true)
  name    String  @default("")
  logoUrl String  @default("")

  settings Settings @relation(fields: [settingsId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([settingsId, gatewayKey])
  @@map("settings_payment_gateways")
}

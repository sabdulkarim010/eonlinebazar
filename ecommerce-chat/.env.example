PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_DASHBOARD_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/ecommerce_chat
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Cloudinary (chat image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email alerts (Gmail SMTP / App Password)
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SERVICE=gmail
NOTIFY_EMAIL=alerts@yourshop.com

# Optional comma-separated extra CORS origins (defaults also include :3000, :5001, :5173)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5001


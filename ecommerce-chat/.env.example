# Chat microservice — copy to .env and fill in values.
# JWT_SECRET, Cloudinary, and INTERNAL_API_KEY are shared from repo-root .env (config/loadEnv.js).

PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ecommerce_chat
CLIENT_URL=http://localhost:5000
ADMIN_DASHBOARD_URL=http://localhost:5000/chat-admin
OPENAI_API_KEY=your_openai_key

# Must match repo-root .env INTERNAL_API_KEY
INTERNAL_API_KEY=your_shared_internal_api_key
MAIN_STORE_API_URL=http://localhost:5000

# Email alerts (Gmail SMTP / App Password)
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
NOTIFY_EMAIL=alerts@yourshop.com

# Comma-separated CORS origins for HTTP + Socket.io
CORS_ORIGIN=http://localhost:5000
SOCKET_CORS_ORIGIN=http://localhost:5000,http://localhost:3000,http://localhost:5173
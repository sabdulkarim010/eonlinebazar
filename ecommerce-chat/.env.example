PORT=5001
NODE_ENV=production
MONGO_URI=your_mongodb_atlas_uri
JWT_SECRET=your_strong_secret_min_32_chars
CLIENT_URL=https://eonlinebazar.com
ADMIN_DASHBOARD_URL=https://eonlinebazar.com/chat-admin
OPENAI_API_KEY=your_openai_key
MAIN_STORE_API_URL=https://eonlinebazar.com

# Cloudinary (chat image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name

# ─── APP ───────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://yourdomain.com
DEFAULT_OG_IMAGE_URL=https://yourdomain.com/images/og-default.jpg
# When true, customers must verify their email before logging in (toggle without code changes).
REQUIRE_EMAIL_VERIFICATION=true

# ─── DATABASE ──────────────────────────────────────
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/eonlinebazar

# ─── REDIS (optional — app works without it) ───────
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=300

# ─── JWT ───────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ─── CLOUDINARY ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── SMTP / EMAIL ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=EOnlineBazar <your@gmail.com>

# ─── SMS PROVIDERS ────────────────────────────────
GREENWEB_SMS_API_KEY=your_key
GREENWEB_SMS_SENDER_ID=your_sender
BULKSMS_BD_API_KEY=your_key
ALPHASMS_API_KEY=your_key

# ─── WHATSAPP ─────────────────────────────────────
ULTRAMSG_INSTANCE_ID=your_instance
ULTRAMSG_TOKEN=your_token
GREEN_API_INSTANCE=your_instance
GREEN_API_TOKEN=your_token
CALLMEBOT_PHONE=your_phone
CALLMEBOT_API_KEY=your_key

# ─── PAYMENT GATEWAYS ─────────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

AAMARPAY_STORE_ID=your_store_id
AAMARPAY_SIGNATURE_KEY=your_signature_key
AAMARPAY_IS_LIVE=false

SHURJOPAY_USERNAME=your_username
SHURJOPAY_PASSWORD=your_password
SHURJOPAY_PREFIX=SP
SHURJOPAY_IS_LIVE=false
SHURJOPAY_RETURN_URL=https://yourdomain.com/payment/shurjopay-return
SHURJOPAY_CANCEL_URL=https://yourdomain.com/payment/cancel

# ─── COURIERS ─────────────────────────────────────
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_API_SECRET=your_steadfast_api_secret

PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_username
PATHAO_PASSWORD=your_pathao_password
PATHAO_STORE_ID=your_pathao_store_id
PATHAO_IS_LIVE=false

REDX_API_TOKEN=your_redx_bearer_token
REDX_IS_LIVE=false

# ─── ENCRYPTION ───────────────────────────────────
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# ─── FINANCE MODULE ───────────────────────────────
FINANCE_ADMIN_EMAIL=finance@yourdomain.com
FINANCE_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── GOOGLE OAUTH ─────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# ─── SESSION / SECURITY ───────────────────────────
ADMIN_GEO_ALLOWED_COUNTRIES=BD
MAX_LOGIN_ATTEMPTS=5
LOGIN_BAN_DURATION_MINUTES=1440
# Allow private IPs even if blocked (true for development)
GEO_ALLOW_PRIVATE=true

# ─── EMERGENCY CONTROL PANEL ─────────────────────
# 🔴 CRITICAL: Keep these SECRET. Never share.
# Generate URL token: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Generate master key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or run: node scripts/generate-emergency-keys.js
EMERGENCY_URL_TOKEN=GENERATE_A_48_CHAR_HEX_STRING
EMERGENCY_MASTER_KEY=GENERATE_A_64_CHAR_HEX_STRING
EMERGENCY_OWNER_NAME=Abdul Karim

# ─── LOW STOCK ALERTS ─────────────────────────────
LOW_STOCK_ALERT_ENABLED=true
LOW_STOCK_CHECK_INTERVAL=0 * * * *
LOW_STOCK_DEFAULT_THRESHOLD=10
ADMIN_ALERT_EMAIL=admin@yourdomain.com

# ─── SANDBOX & RESET ──────────────────────────────
# 🔴 CRITICAL SECRET — needed to wipe REAL order data
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REAL_DATA_RESET_KEY=GENERATE_A_64_CHAR_HEX_STRING

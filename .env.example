# ─── APP ───────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://yourdomain.com
# When true, customers must verify their email before logging in (toggle without code changes).
REQUIRE_EMAIL_VERIFICATION=true

# ─── DATABASE ──────────────────────────────────────
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/eonlinebazar

# ─── JWT ───────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ─── CLOUDINARY ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── SMTP / EMAIL ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=EOnlineBazar <your@gmail.com>

# ─── SMS PROVIDERS ────────────────────────────────
GREENWEB_SMS_API_KEY=your_key
GREENWEB_SMS_SENDER_ID=your_sender
BULKSMS_BD_API_KEY=your_key
ALPHASMS_API_KEY=your_key

# ─── WHATSAPP ─────────────────────────────────────
ULTRAMSG_INSTANCE_ID=your_instance
ULTRAMSG_TOKEN=your_token
GREEN_API_INSTANCE=your_instance
GREEN_API_TOKEN=your_token
CALLMEBOT_PHONE=your_phone
CALLMEBOT_API_KEY=your_key

# ─── PAYMENT GATEWAYS ─────────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

AAMARPAY_STORE_ID=your_store_id
AAMARPAY_SIGNATURE_KEY=your_signature_key
AAMARPAY_IS_LIVE=false

SHURJOPAY_USERNAME=your_username
SHURJOPAY_PASSWORD=your_password
SHURJOPAY_PREFIX=SP
SHURJOPAY_IS_LIVE=false
SHURJOPAY_RETURN_URL=https://yourdomain.com/payment/shurjopay-return
SHURJOPAY_CANCEL_URL=https://yourdomain.com/payment/cancel

# ─── COURIERS ─────────────────────────────────────
STEADFAST_API_KEY=your_api_key
STEADFAST_API_SECRET=your_api_secret
PATHAO_CLIENT_ID=your_client_id
PATHAO_CLIENT_SECRET=your_client_secret
PATHAO_USERNAME=your_username
PATHAO_PASSWORD=your_password
REDX_API_TOKEN=your_token

# ─── ENCRYPTION ───────────────────────────────────
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# ─── FINANCE MODULE ───────────────────────────────
FINANCE_ADMIN_EMAIL=finance@yourdomain.com
FINANCE_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── SESSION / SECURITY ───────────────────────────
ADMIN_GEO_ALLOWED_COUNTRIES=BD
MAX_LOGIN_ATTEMPTS=5
LOGIN_BAN_DURATION_MINUTES=1440
